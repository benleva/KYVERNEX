  "phase": "alpha",
  "objectives": [
    {
      "id": 1,
      "priority": 1,
      "text": "Creare il plugin KYVERNEX operativo seguendo la strada più breve e veloce."
    },
    {
      "id": 2,
      "priority": 2,
      "text": "Consentire all'agente AI in Visual Studio Code di usare autonomamente KPM e KGO per sviluppare il plugin stesso."
    }
  ],
  "rules": [
    {
      "id": "ARGUS-ALPHA-001",
      "effect": "BLOCK",
      "condition": "task.objective_id not in [1, 2]",
      "reason": "OUTSIDE_ALPHA_SCOPE"
    },
    {
      "id": "ARGUS-ALPHA-002",
      "effect": "REQUIRE",
      "condition": "task.has_simpler_equivalent == true",
      "action": "USE_SIMPLER_EQUIVALENT"
    },
    {
      "id": "ARGUS-ALPHA-003",
      "effect": "REQUIRE",
      "condition": "session.end == true",
      "action": "UPDATE_KPM_AND_KGO"
    }
  ]
}
