{
  "schema": "kyvernex.argus.rules.v1",
  "module": "KTC",
  "created_at": "2026-07-27T12:36:08+02:00",
  "updated_at": "2026-07-27T12:36:08+02:00",
  "timezone": "Europe/Rome",
  "time_source": "SYSTEM",
  "rules": [
    {"id": "KTC-001", "when": "artifact_created", "action": "ADD_CREATED_AT_UPDATED_AT_TIMEZONE_SOURCE", "mandatory": true},
    {"id": "KTC-002", "when": "artifact_modified", "action": "UPDATE_UPDATED_AT_AND_APPEND_TIMELINE", "mandatory": true},
    {"id": "KTC-003", "when": "ai_response", "action": "ADD_RESPONSE_TIMESTAMP", "mandatory": true},
    {"id": "KTC-004", "when": "ai_response", "action": "DISPLAY_RESPONSE_TIMESTAMP_IF_HOST_SUPPORTS", "mandatory": false}
  ],
  "response_format": "📅 {date} · 🕒 {time} · 🌍 {timezone}"
}
